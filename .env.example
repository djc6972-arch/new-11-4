# Copy to .env.local for local development. Never commit real values.
# Set the same names in Vercel -> Project -> Settings -> Environment Variables.
DATABASE_URL=        # added automatically when you connect Neon in Vercel's Storage tab
ANTHROPIC_API_KEY=   # from console.anthropic.com -> API Keys
STRIPE_SECRET_KEY=   # from dashboard.stripe.com -> Developers -> API keys (sk_test_... while testing)
PRO_PRICE_CENTS=499  # optional; set to 100 for the $1 live charge
